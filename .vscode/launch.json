{
  // Press F5 (or the ▶ in the Run and Debug panel, ⇧⌘D) to open the Image Downloader window.
  // The first configuration is the default one.
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Image Downloader (UI)",
      "request": "launch",
      "mainClass": "org.ogm.imagedownload.DownloaderApp",
      "projectName": "image-download",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole"
    },
    {
      // No window: downloads with the values in download.local.properties.
      "type": "java",
      "name": "Console: download configured series",
      "request": "launch",
      "mainClass": "org.ogm.imagedownload.Main",
      "projectName": "image-download",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "type": "java",
      "name": "Console: ask for range",
      "request": "launch",
      "mainClass": "org.ogm.imagedownload.Main",
      "projectName": "image-download",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": "start=${input:start} end=${input:end}"
    }
  ],
  "inputs": [
    { "id": "start", "type": "promptString", "description": "First number", "default": "0" },
    { "id": "end", "type": "promptString", "description": "Last number (inclusive)", "default": "999" }
  ]
}
