# Copy this file to download.local.properties (git-ignored) and edit it.
# Only the keys you set override the defaults in src/main/resources/download.properties.
# The window starts from these values; after that it remembers what you type (ui.local.properties).

url.template=https://test.com/media/b/r/name/1000/image_{n}.jpg
# second series from the original code:
# url.template=https://test.com/media/v/e/name-19/1000/name-19_{n}.jpg
file.template=name_{n}.jpg
start=0
end=999
output.dir=downloads

